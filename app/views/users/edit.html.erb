<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow border-dark">
        <div class="card-header bg-dark text-white py-3">
          <h3 class="mb-0 fw-bold">⚙️ ユーザー編集</h3>
        </div>
        <div class="card-body p-4">
          
          <%= form_with model: @user, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :name, "名前", class: "form-label fw-bold" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, "メールアドレス", class: "form-label fw-bold" %>
              <%= f.email_field :email, class: "form-control" %>
            </div>

            <div class="d-grid gap-2 mt-4">
              <%= f.submit "更新", class: "btn btn-success fw-bold" %>
              
              <%= link_to "退会する", "#", class: "btn btn-danger fw-bold" %> 
              <%= link_to "戻る", user_path(@user), class: "btn btn-outline-secondary" %>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>