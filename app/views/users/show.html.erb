<div class="container mt-4">
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card shadow border-dark text-center">
        <div class="card-header bg-dark text-white py-3">
          <h4 class="mb-0 fw-bold">🛡️ <%= @user.name %> のステータス</h4>
        </div>
        <div class="card-body py-4">
          
          <div class="mb-4 text-start d-inline-block" style="min-width: 180px;">
            <div class="d-flex align-items-center mb-2">
              <span class="badge bg-warning text-dark me-2 fw-bold" style="width: 100px;">階級</span>
              <span class="fw-bold text-dark">冒険者</span>
            </div>
            
            <div class="d-flex align-items-center mb-2">
              <span class="badge bg-secondary text-white me-2 fw-bold" style="width: 100px;">作成クエスト</span>
              <span class="fw-bold text-dark"><%= @user.quests.count %> 件</span>
            </div>

            <%# <div class="d-flex align-items-center mb-2"> %>
              <%# <span class="badge bg-success text-white me-2 fw-bold" style="width: 100px;">完了クエスト</span> %>
              <%# <span class="fw-bold text-dark"><%= @user.quests.where(is_completed: true).count %> <%# 件</span> %>
            <%# </div> %>

            <div class="d-flex align-items-center">
              <span class="badge bg-secondary text-white me-2 fw-bold" style="width: 100px;">コメント数</span>
              <span class="fw-bold text-dark"><%= Comment.where(quest_id: @user.quests.pluck(:id)).count %> 回</span>
            </div>
          </div> <h3 class="fw-bold mb-1" style="color: #3e2723;"><%= @user.name %></h3>
          <p class="text-muted small mb-4"><%= @user.email %></p>
          
          <hr>
          
          <% if @user == current_user %>
            <%= link_to "⚙️ 登録情報の編集・退会", edit_user_registration_path, class: "btn btn-outline-secondary w-100 fw-bold" %>
          <% else %>
            <%= link_to "🏠 自分のマイページに戻る", user_path(current_user), class: "btn btn-primary w-100 fw-bold" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <h2 class="fw-bold fs-3 text-center" style="color: #3e2723; display: table; margin: 0 auto 24px; border-bottom: 3px solid #ffc107; padding-bottom: 10px;">
        📜 <%= @user.name %> のクエスト（<%= @quests.count %> 件）
      </h2>
      
     <% if @quests.any? %>
        <div class="row">
          <% @quests.each do |quest| %>
            <div class="col-12 mb-3">
              <div class="card shadow-sm border-warning" style="background-color: #fffde7;">
                <div class="card-body d-flex align-items-center justify-content-between py-3">
                  <div style="flex: 1; min-width: 0;" class="pe-3">
                    <h5 class="card-title fw-bold text-truncate mb-1"><%= quest.title %></h5>
                    <p class="card-text text-muted small mb-0 text-truncate"><%= quest.body %></p>
                  </div>
                  <div class="text-end" style="flex-shrink: 0;">
                    <%= link_to "作戦確認", quest_path(quest), class: "btn btn-warning btn-sm fw-bold px-3" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card p-5 text-center shadow-sm border-dashed">
          <p class="text-muted mb-0">まだ受注したクエストはありません。目標を設定してクエストを受注しましょう！</p>
        </div>
      <% end %>
    </div>
  </div>
</div>