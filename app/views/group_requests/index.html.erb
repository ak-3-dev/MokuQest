<div class="container mt-5">
  <div class="text-center mb-5">
    <h2 class="fw-bold" style="color: #3e2723; display: inline-block; border-bottom: 3px solid #ffc107; padding-bottom: 10px;">
      参加申請一覧
    </h2>
  </div>

  <% if @group_requests.any? %>
    <% @group_requests.each do |request| %>
      <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">

          <div>
            <h5 class="mb-1"><%= request.user.name %></h5>
            <p class="text-muted mb-0">
              申請日：<%= request.created_at.strftime("%Y/%m/%d") %>
            </p>
          </div>

          <div class="d-flex gap-2">
            <%= button_to "承認",
                group_group_request_path(@group, request),
                method: :patch,
                params: { status: "approved" },
                class: "btn btn-success" %>

            <%= button_to "却下",
                group_group_request_path(@group, request),
                method: :patch,
                params: { status: "rejected" },
                class: "btn btn-danger" %>
          </div>

        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-5">
      <p class="text-warning fw-bold">
        現在、参加申請はありません。
      </p>
    </div>
  <% end %>
</div>