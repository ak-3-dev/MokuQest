<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Moku Quest" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
    
    <link href="https://fonts.googleapis.com/css2?family=Sawarabi+Mincho&display=swap" rel="stylesheet">
  </head>

  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark shadow-sm py-3 bg-guild-navbar">
        <div class="container">
          <%= link_to "📜 モククエスト ⚔️", root_path, class: "navbar-brand fw-bold fs-3", style: "color: #deff9a;" %>

          <div class="d-flex align-items-center">
            <ul class="navbar-nav flex-row ms-auto align-items-center">
              <li class="nav-item">
                <%= link_to "ギルド案内所", about_path, class: "nav-link text-white px-3" %>
              </li>
              <% if user_signed_in? %>
                <li class="nav-item">
                  <%= link_to "🛡️ マイページ", user_path(current_user), class: "btn btn-outline-warning btn-sm mx-1 fw-bold" %>
                </li>
                <li class="nav-item">
                  <%= link_to "クエスト受注", new_quest_path, class: "btn btn-outline-warning btn-sm mx-1 fw-bold" %>
                </li>
                <li class="nav-item">
                  <%= link_to "クエスト一覧", quests_path, class: "btn btn-outline-warning btn-sm mx-1 fw-bold" %>
                </li>
                <li class="nav-item">
                  <%= link_to "ギルド設立", new_group_path, class: "btn btn-outline-warning btn-sm mx-1 fw-bold" %>
                </li>
                <li class="nav-item">
                  <%= link_to "ギルド掲示板", groups_path, class: "btn btn-outline-warning btn-sm mx-1 fw-bold" %>
                </li>
                <li class="nav-item text-white me-3">
                  階級: 冒険者 (<%= current_user.name %>)
                </li>
                <li class="nav-item">
                  <%= link_to "ギルド退館", destroy_user_session_path, class: "btn btn-outline-danger btn-sm mx-2" %>
                </li>
              <% else %>
                <li class="nav-item">
                  <%= link_to "冒険者登録", new_user_registration_path, class: "btn btn-outline-warning btn-sm mx-2" %>
                </li>
                <li class="nav-item">
                  <%= link_to "ギルド入館", new_user_session_path, class: "btn btn-warning btn-sm mx-2" %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav> 
    </header>

    <% if user_signed_in? %>
      <%= form_with url: search_path, method: :get, class: "search-form" do |f| %>
        <%= f.text_field :keyword, value: @keyword, placeholder: "検索ワードを入力" %>
        
        <%= f.select :range, options_for_select([["ユーザー", "user"], ["クエスト", "quest"]], @range) %>
        
        <%= f.select :search_method, options_for_select([["完全一致", "perfect"], ["部分一致", "partial"]], @search_method) %>
        
        <%= f.submit "検索" %>
      <% end %>
    <% end %>

    <main class="container my-5">
      <%= yield %>
    </main>
  </body>
</html>