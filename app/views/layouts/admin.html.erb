<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Moku Quest" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM"
          crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

    <link href="https://fonts.googleapis.com/css2?family=Sawarabi+Mincho&display=swap" rel="stylesheet">
  </head>

  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark shadow-sm py-3 bg-guild-navbar">
        <div class="container">

          <%= link_to "🛡️ モククエスト 管理本部",
              admin_users_path,
              class: "navbar-brand fw-bold fs-3",
              style: "color:#deff9a;" %>

          <div class="d-flex align-items-center">

            <ul class="navbar-nav flex-row ms-auto align-items-center">

              <li class="nav-item">
                <%= link_to "👥 ユーザー管理",
                    admin_users_path,
                    class: "btn #{current_page?(admin_users_path) ? 'btn-warning' : 'btn-outline-warning'} btn-sm mx-1 fw-bold" %>
              </li>

              <li class="nav-item">
                <%= link_to "🏰 グループ管理",
                    admin_groups_path,
                    class: "btn #{current_page?(admin_groups_path) ? 'btn-warning' : 'btn-outline-warning'} btn-sm mx-1 fw-bold" %>
              </li>

              <li class="nav-item">
                <%= link_to "💬 コメント管理",
                    admin_comments_path,
                    class: "btn #{current_page?(admin_comments_path) ? 'btn-warning' : 'btn-outline-warning'} btn-sm mx-1 fw-bold" %>
              </li>

              <li class="nav-item text-white me-3">
                管理者
              </li>

              <li class="nav-item">
                <%= link_to "ログアウト",
                    destroy_admin_session_path,
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm mx-2" %>
              </li>

            </ul>

          </div>

        </div>
      </nav>
    </header>

    <main class="container my-5">
      <%= yield %>
    </main>

  </body>
</html>