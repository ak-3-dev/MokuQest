<% if @ai_plan.errors.any? %>
  <div class="alert alert-danger container mt-4">
    <h5 class="fw-bold">⚠️ <%= @ai_plan.errors.count %> 件のエラーにより保存できませんでした:</h5>
    <ul>
      <% @ai_plan.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow border-warning">
        <div class="card-header bg-warning text-dark py-3">
          <h3 class="mb-0 fw-bold">📜 新規クエスト受注</h3>
        </div>
        <div class="card-body p-4">
          <%= form_with model: @ai_plan, url: ai_plans_path, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :goal, "達成したい目標", class: "form-label fw-bold" %>
              <%= f.text_area :goal,
                  class: "form-control",
                  rows: 3,
                  placeholder: "例：Railsエンジニアになる" %>
            </div>

            <div class="mb-3">
              <%= f.label :period, "期間", class: "form-label fw-bold" %>
              <%= f.text_field :period,
                  class: "form-control",
                  placeholder: "例：180日" %>
            </div>

            <div class="mb-3">
              <%= f.label :level, "現在のレベル", class: "form-label fw-bold" %>
              <%= f.select :level,
                  ["初心者", "中級者", "上級者"],
                  {},
                  class: "form-select" %>
            </div>
            <%= f.submit "クエストを受注する", class: "btn btn-warning w-100 fw-bold shadow-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>