<% if @quest.errors.any? %>
  <div class="alert alert-danger">
    <h5 class="fw-bold>"⚠️ <%= @quest.errors.count %> 件のエラーにより保存できませんでした:</h5>
    <ul>
      <% @quest.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-4">
      <div class="card shadow-sm border-warning mb-4" style="background-color: #fff9c4;">
        <div class="card-body">
          <h4 class="card-title text-brown fw-bold">📜 新規クエスト受注</h4>
          <%= form_with model: @quest do |f| %>
            <div class="mb-3">
              <%= f.label :title, "クエスト名（目標）", class: "form-label fw-bold" %>
              <%= f.text_field :title, class: "form-control", placeholder: "例：Rubyを極める" %>
            </div>
            <div class="mb-3">
              <%= f.label :body, "詳細内容", class: "form-label fw-bold" %>
              <%= f.text_area :body, class: "form-control", rows: 4, placeholder: "何を達成するか詳しく書こう" %>
            </div>
            <%= f.submit "クエストを受注する", class: "btn btn-warning w-100 fw-bold shadow-sm" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <h2 class="mb-4 fw-bold" style="color: #3e2723;">⚔️ 現在のクエスト一覧</h2>
      <div class="row">
        <% @quests.each do |quest| %>
          <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-secondary">
              <div class="card-body">
                <h5 class="card-title fw-bold"><%= quest.title %></h5>
                <p class="card-text text-muted small"><%= truncate(quest.body, length: 50) %></p>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="badge bg-info text-dark">冒険者: <%= quest.user.name %></span> <%= link_to "詳細を見る", quest_path(quest), class: "btn btn-outline-primary btn-sm" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>