<div class="container mt-5">
  <div class="text-center mb-5">
    <h2 class="fw-bold" style="color: #3e2723; display: inline-block; border-bottom: 3px solid #ffc107; padding-bottom: 10px;">
      ⚔️ 現在のクエスト一覧（ギルド掲示板）
    </h2>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-9">
      <% if @quests.any? %>
        <% @quests.each do |quest| %>
          <div class="card shadow-sm border-secondary mb-3">
            <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
              
              <div style="flex: 1; min-width: 250px;">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <h5 class="card-title fw-bold text-dark mb-0"><%= quest.title %></h5>
                  <span class="badge bg-info text-dark">
                    👤 <%= quest.user.name %>
                  </span>
                </div>
                <p class="card-text text-muted small mb-0">
                  <%= truncate(quest.body, length: 80) %>
                </p>
              </div>
              
              <div class="text-end">
                <%= link_to "詳細を見る", quest_path(quest), class: "btn btn-outline-primary fw-bold" %>
              </div>

            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <p class="text-muted fs-5">現在受注されているクエストはありません。</p>
          <%= link_to "クエストを受注する", new_quest_path, class: "btn btn-warning fw-bold mt-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>