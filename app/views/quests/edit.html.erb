<% if @quest.errors.any? %>
  <div class="alert alert-danger">
    <h5 class="fw-bold>"⚠️ <%= @quest.errors.count %> 件のエラーにより保存できませんでした:</h5>
    <ul>
      <% @quest.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow border-success">
        <div class="card-header bg-success text-white py-3">
          <h3 class="mb-0 fw-bold">🛠️ クエスト作戦変更</h3>
        </div>
        <div class="card-body p-4">
          <%= form_with model: @quest do |f| %>
            <div class="mb-3">
              <%= f.label :title, "クエスト名", class: "form-label fw-bold" %>
              <%= f.text_field :title, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :body, "詳細内容", class: "form-label fw-bold" %>
              <%= f.text_area :body, class: "form-control", rows: 6 %>
            </div>
            <div class="d-flex gap-2 mt-4">
              <%= f.submit "変更を保存する", class: "btn btn-success w-50 fw-bold" %>
              <%= link_to "戻る", quest_path(@quest), class: "btn btn-outline-secondary w-50" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>