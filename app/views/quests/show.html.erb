<div class="container mt-5">
  <div class="card shadow border-warning overflow-hidden">
    <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h2 class="mb-0 fw-bold text-white">📜 クエスト詳細: <%= @quest.title %></h2>

      <div class="fs-5">
        <span class="fw-bold" style="color: #ffc107 !important;">依頼主:</span>
    
        <%= link_to user_path(@quest.user), class: "fw-bold text-decoration-none", style: "color: #ffc107 !important;" do %>
          👤 <%= @quest.user.name %>
        <% end %>
      </div>
    </div>
    <div class="card-body p-4" style="background-color: #fafafa;">
      <p class="lead" style="white-space: pre-wrap;"><%= @quest.body %></p>
      <hr>
      <% if @ai_plan.present? %>
        <div class="card border-success mt-4 mb-4">
          <div class="card-header bg-success text-white">
            🤖 AIクエスト
          </div>

          <div class="card-body">

            <p class="mb-1">
              <strong>期間:</strong>
              <%= @ai_plan.period %>
            </p>

            <p class="mb-3">
              <strong>レベル:</strong>
              <%= @ai_plan.level %>
            </p>

            <% @ai_plan.ai_tasks.each do |task| %>

              <div class="d-flex justify-content-between mb-2">

                <div>
                  <% if task.completed %>
                    ✅
                  <% else %>
                    ☐
                  <% end %>

                  <%= task.title %>
                </div>

                <span>
                  <%= task.exp %> EXP
                </span>

              </div>

            <% end %>

            <%= link_to "AIクエスト詳細",
                ai_plan_path(@ai_plan),
                class: "btn btn-outline-success btn-sm mt-3" %>

          </div>
        </div>

      <% end %>
      <div class="mt-4 d-flex gap-2">
        <%= link_to "掲示板に戻る", quests_path, class: "btn btn-secondary" %>

        <% if @quest.user == current_user %>
          <%= link_to "作戦変更", edit_quest_path(@quest), class: "btn btn-success" %>
          <%= button_to "クエスト取消", quest_path(@quest), method: :delete, onclick: "return confirm('本当にこのクエストを取り消しますか？');", class: "btn btn-danger" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-5">
    <h3 class="text-white fw-bold mb-3">ギルド掲示板（コメント一覧）</h3>
    
    <% @quest.comments.each do |comment| %>
      <% if comment.persisted? %> 
        <div class="comment mb-3 p-3 bg-light border rounded text-dark">
          <p class="fw-bold mb-1">
            冒険者: 
            <%= link_to user_path(comment.user), class: "text-dark text-decoration-none fw-bold" do %>
              👤 <%= comment.user.name %>
            <% end %>
          </p>
          <p class="mb-2"><%= comment.comment %></p>

          <% if comment.user == current_user %>
            <div class="mt-2">
              <%= button_to "クエスト（コメント）取り消し", quest_comment_path(@quest, comment), method: :delete, onclick: "return confirm('本当に削除しますか？');", data: { turbo: false }, class: "btn btn-sm btn-outline-danger" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <hr class="my-2 border-light">

    <h4 class="mb-1 text-white fw-bold">進捗報告・応援メッセージ</h4>
    
    <% if alert %>
      <div class="alert alert-danger text-danger fw-bold my-2" style="background-color: #f8d7da; border-color: #f5c6cb; border-radius: 6px;">
        ⚠️ <%= alert %>
      </div>
    <% end %>
    
    <%= form_with(model: [@quest, Comment.new], local: true) do |f| %>
      <div class="comment-form-container">
        <%= f.text_area :comment, class: "form-control mt-1 mb-0 comment-textarea", rows: 3, placeholder: "クエストへの進捗報告や応援を書き込もう！" %>
        
        <%= f.submit "送信", class: "custom-submit-btn" %>
      </div>
    <% end %>
  </div>
</div>