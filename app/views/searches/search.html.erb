<div class="search-results-container">
  <h2>🔍 検索結果</h2>

  <% if @range == "user" %> <h3>⚔️ 冒険者の検索結果</h3>
    <% if @results.present? %>
      <div class="results-list">
        <% @results.each do |user| %>
          <p class="result-item"><%= link_to user.name, user_path(user) %></p> 
        <% end %>
      </div>
    <% else %>
      <p class="no-result">該当する冒険者は見つかりませんでした。</p>
    <% end %>
  <% elsif @range == "quest" %>
    <h3>📜 クエストの検索結果</h3>
    <% if @results.present? %>
      <div class="results-list">
        <% @results.each do |quest| %>
          <p class="result-item"><%= link_to quest.title, quest_path(quest) %></p>
        <% end %>
      </div>
    <% else %>
      <p class="no-result">該当する項目は見つかりませんでした。</p>
    <% end %>
  <% end %>
</div>