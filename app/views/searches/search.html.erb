<h2>検索結果</h2>

<% if params[:range] == "user" %>
  <h3>冒険者の検索結果</h3>
  <% if @results.present? %>
    <% @results.each do |user| %>
      <p><%= link_to user.name, user_path(user) %></p> 
    <% end %>
  <% else %>
    <p>該当する冒険者は見つかりませんでした。</p>
  <% end %>
<% elsif params[:range] == "quest" %>
  <h3>クエストの検索結果</h3>
  <% if @results.present? %>
    <% @results.each do |quest| %>
      <p><%= link_to quest.title, quest_path(quest) %></p>
    <% end %>
  <% else %>
    <p>該当する項目は見つかりませんでした。</p>
  <% end %>

<% end %>