<h2 class="fw-bold fs-3 text-center"
    style="color: #ffc107; display: table; margin: 0 auto 24px; border-bottom: 3px solid #ffc107; padding-bottom: 10px;">
  🎯 <%= @ai_plan.goal %>
</h2>

<div class="text-center mb-4" style="color: #ffc107;">
  📅 <span class="fs-5 fw-bold">期間: <%= @ai_plan.period %></span>
  <span class="mx-3">|</span>
  ⭐ <span class="fs-5 fw-bold">レベル: <%= @ai_plan.level %></span>
</div>
<% @today_tasks.each do |task| %>
  <details class="card mb-3">

    <summary class="card-header">
      <% if task.completed %>
        ✅
      <% else %>
        ☐
      <% end %>

      <%= task.title %>
      （<%= task.exp %> EXP）
    </summary>

    <div class="card-body">

      <%= simple_format(task.description) %>

      <% unless task.completed %>
        <%= button_to "達成する",
          complete_ai_plan_ai_task_path(@ai_plan, task),
          method: :patch,
          class: "btn btn-success" %>
      <% end %>

    </div>

  </details>
<% end %>