<h2 class="fw-bold fs-3 text-center"
    style="color: #ffc107; display: table; margin: 0 auto 24px; border-bottom: 3px solid #ffc107; padding-bottom: 10px;">
  🎯 <%= @ai_plan.goal %>
</h2>

<div class="text-center mb-4" style="color: #ffc107;">
  📅 <span class="fs-5 fw-bold">期間: <%= @ai_plan.period %></span>
  <span class="mx-3">|</span>
  ⭐ <span class="fs-5 fw-bold">レベル: <%= @ai_plan.level %></span>
</div>

<% if @ai_plan.ai_tasks.empty? %>

  <div class="text-center mt-5">
    <div class="spinner-border text-warning mb-4"
         role="status"
         style="width: 4rem; height: 4rem;">
      <span class="visually-hidden">Loading...</span>
    </div>

    <h3 class="fw-bold text-warning mb-3">
      ⚔️ クエストを生成しています...
    </h3>

    <p id="loading-message" class="fs-5">
      ギルドマスターがあなたの目標を分析しています...
    </p>

    <p class="text-muted">
      しばらくお待ちください...
    </p>

    <div class="progress mt-4"
     role="progressbar"
     aria-label="AIクエスト生成進捗"
     aria-valuemin="0"
     aria-valuemax="100"
     style="height: 24px;">

      <div id="generation-progress-bar"
          class="progress-bar progress-bar-striped progress-bar-animated bg-warning text-dark fw-bold"
          style="width: 0%;">
        0%
      </div>
    </div>

    <p id="generation-progress-text"
      class="mt-2 text-muted">
      0 / <%= @ai_plan.period.to_i %> 日分のクエストを生成中...
    </p>
  </div>

  <script>
  const messages = [
    "ギルドマスターがあなたの目標を分析しています...",
    "現在の冒険者レベルを確認しています...",
    "最終目標までの冒険ルートを探索しています...",
    "あなたに合ったクエスト難易度を調整しています...",
    "毎日のクエストを編成しています...",
    "獲得EXPのバランスを確認しています...",
    "冒険の準備はもうすぐ完了です..."
  ];

  let messageIndex = 0;
  const messageElement = document.getElementById("loading-message");

  // 2秒ごとにメッセージを変更
  setInterval(() => {
    messageIndex = (messageIndex + 1) % messages.length;
    messageElement.textContent = messages[messageIndex];
  }, 2000);

  // AIクエストの生成状況を確認
  const checkGenerationStatus = async () => {
    try {
      const response = await fetch(
        "<%= status_ai_plan_path(@ai_plan) %>",
        {
          headers: {
            "Accept": "application/json"
          }
        }
      );

      if (!response.ok) {
        throw new Error("生成状況の取得に失敗しました");
      }

      const data = await response.json();

      console.log(
        `AIクエスト生成状況: ${data.generated_tasks}/${data.total_tasks}`
      );

      const progressBar = document.getElementById("generation-progress-bar");
      const progressText = document.getElementById("generation-progress-text");

      const percentage =
        data.total_tasks > 0
          ? Math.round((data.generated_tasks / data.total_tasks) * 100)
          : 0;

      const generatedDays = Math.floor(data.generated_tasks / 3);
      const totalDays = Math.floor(data.total_tasks / 3);

      progressBar.style.width = `${percentage}%`;
      progressBar.textContent = `${percentage}%`;
      progressBar.setAttribute("aria-valuenow", percentage);

      progressText.textContent =
        `${generatedDays} / ${totalDays} 日分のクエストを生成中...`;

      if (data.completed) {
        progressText.textContent = "🎉 冒険の準備が完了しました！";

        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }

    } catch (error) {
      console.error(error);
    }
  };

  // 2秒ごとに生成状況だけ確認
  setInterval(checkGenerationStatus, 2000);
</script>

<% else %>

  <% @today_tasks.each do |task| %>
    <details class="card mb-3">

      <summary class="card-header">
        <% if task.completed %>
          ✅
        <% else %>
          ☐
        <% end %>

        <%= task.title %>
        （<%= task.exp %> EXP）
      </summary>

      <div class="card-body">
        <%= simple_format(task.description) %>

        <% unless task.completed %>
          <%= button_to "達成する",
            complete_ai_plan_ai_task_path(@ai_plan, task),
            method: :patch,
            class: "btn btn-success" %>
        <% end %>
      </div>

    </details>
  <% end %>

<% end %>