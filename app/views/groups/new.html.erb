<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-lg border-warning bg-dark bg-opacity-75 text-light">
        <div class="card-header text-center border-warning">
          <h2 class="fw-bold text-warning mb-0">
            ⚔ ギルド作成
          </h2>
        </div>

        <% if @group.errors.any? %>
          <div class="alert alert-danger m-3">
            <h5 class="mb-2">入力内容を確認してください。</h5>
            <ul class="mb-0">
              <% @group.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="card-body p-4">
          <%= form_with model: @group, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :name, "ギルド名", class: "form-label fw-bold" %>
              <%= f.text_field :name,
                  class: "form-control py-2",
                  placeholder: "例）みんなの冒険者ギルド" %>
            </div>
  
            <div class="mb-3">
              <%= f.label :description, "説明", class: "form-label fw-bold" %>
              <%= f.text_area :description,
                  class: "form-control py-2",
                  rows: 3,  
                  placeholder: "例）\n毎日の学習報告や質問・相談を行うギルドです。" %>
            </div>

            <div class="mb-3">
              <%= f.label :rules, "ギルド規約", class: "form-label fw-bold" %>
              <%= f.text_area :rules,
                  class: "form-control py-2",
                  rows: 5,  
                  placeholder: "例）\n・誹謗中傷は禁止\n・初心者歓迎\n・週1回進捗報告" %>
            </div>
            <%= f.submit "ギルドを設立する", class: "btn btn-warning w-100 fw-bold shadow-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>