<div class="container mt-5">
  <div class="text-center mb-5">
    <div class="text-center mb-5">
      <h2 class="fw-bold" style="color: #3e2723; display: inline-block; border-bottom: 3px solid #ffc107; padding-bottom: 10px;">
        グループ一覧
      </h2>
    </div>

    <div class="mb-4">
      <%= form_with url: groups_path, method: :get, local: true do |f| %>
        <div class="input-group">
          <%= f.text_field :keyword,
              class: "form-control",
              placeholder: "グループ名・説明・ルールから検索" %>

          <%= f.submit "検索",
              class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-9">
      <% if @groups.any? %>
        <% @groups.each do |group| %>
          <div class="card shadow-sm border-secondary mb-3">
            <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
              
              <div class="flex-grow-1">
                <h5 class="card-title fw-bold text-dark mb-2">
                  <%= group.name %>
                </h5>

                <p class="card-text text-muted small mb-2">
                  <%= truncate(group.description, length: 80) %>
                </p>

                <div class="d-flex gap-3 text-muted small">
                  <p class="mb-0">👤 <%= group.user.name %></p>
                  <p class="mb-0">📅 <%= group.created_at.strftime("%Y/%m/%d") %></p>
                </div>
              </div>

              <div class="text-end">
                <%= link_to "詳細を見る", group_path(group), class: "btn btn-outline-primary fw-bold" %>
              </div>

            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <p class="text-warning fw-bold">
            該当するグループはありません
          </p>
          <%= link_to "一覧に戻る",
              groups_path,
              class: "btn btn-outline-warning fw-bold" %>
        </div>
      <% end %>
    </div> 
  </div> 
</div>