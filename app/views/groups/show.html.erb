<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow border-secondary">
        <div class="card-header bg-secondary text-white py-3">
          <h3 class="mb-0 fw-bold">
            👥 グループ詳細
          </h3>
        </div>

        <div class="card-body p-4">
          <h3 class="fw-bold text-center mb-4">
            📚 <%= @group.name %>
          </h3>
          <h5 class="fw-bold mt-4">
            説明
          </h5>
          <p>
            <%= @group.description %>
          </p>

          <h5 class="fw-bold mt-4">
            ルール
          </h5>
          <p>
            <%= simple_format(@group.rules) %>
          </p>

          <div class="d-flex gap-3 text-muted">
            <p class="mb-0">
              🏆 <%= @group.user.name %>
            </p>

            <p class="mb-0">
              📅 <%= @group.created_at.strftime("%Y/%m/%d") %>
            </p>
          </div>

          <div class="d-flex gap-3 text-muted">
            <p class="mb-0">
              参加メンバー <%= @group.members.count %>人
            </p>
          </div>

          <% @group.members.each do |member| %>
            <p>
              👤 <%= member.name %>
            </p>
          <% end %>

          <div class="d-grid gap-2 mt-4">
            <% request = current_user.group_requests.find_by(group: @group) %>
            <% if current_user == @group.user %>
              <button class="btn btn-secondary w-100" disabled>
                グループ管理者
              </button>
            <% elsif request.nil? %>
              <%= button_to "参加申請",
                  group_group_requests_path(@group),
                  method: :post,
                  class: "btn btn-success fw-bold w-100" %>
            <% elsif request.pending? %>
              <button class="btn btn-warning w-100" disabled>
                申請中
              </button>
            <% elsif request.approved? %>
              <%= button_to "退会する",
                  group_group_request_path(@group,request),
                  method: :delete,
                  data: {
                    turbo_confirm: "本当に退会しますか？"
                  },
                  class: "btn btn-danger fw-bold w-100" %>
            <% elsif request.rejected? %>
              <button class="btn btn-danger w-100" disabled>
                却下されています
              </button>
            <% end %>

            <%= link_to "グループ一覧へ戻る",
                groups_path,
                class: "btn btn-outline-secondary" %>

            <% if current_user == @group.user %>
              <%= link_to "参加申請一覧",
                  group_group_requests_path(@group),
                  class: "btn btn-outline-primary" %>
            
              <%= button_to "グループを削除",
                  group_path(@group),
                  method: :delete,
                  form: {
                    data: {
                      turbo_confirm: "本当にこのグループを削除しますか？"
                    }
                  },
                  class: "btn btn-outline-danger fw-bold" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>