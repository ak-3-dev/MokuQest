<h1 class="admin-title">グループ一覧</h1>
<div class="title-line"></div>

<table class="admin-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>グループ名</th>
      <th>作成者</th>
      <th>作成日</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @groups.each do |group| %>
      <tr>
        <td><%= group.id %></td>
        <td><%= group.name %></td>
        <td><%= group.user.name %></td>
        <td><%= l group.created_at, format: :short %></td>
        <td>
          <%= button_to "削除",
              admin_group_path(group),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "このグループを削除しますか？"
                }
              },
              class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>