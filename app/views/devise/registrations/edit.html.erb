<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow border-dark mb-4">
        <div class="card-header bg-dark text-white py-3">
          <h2 class="mb-0 fw-bold fs-4">⚙️ 冒険者情報の変更</h2>
        </div>
        <div class="card-body p-4">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :name, "氏名", class: "form-label fw-bold" %>
              <%= f.text_field :name, autofocus: true, class: "form-box form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, "メールアドレス", class: "form-label fw-bold" %>
              <%= f.email_field :email, class: "form-control" %>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-info small">現在、次のアドレスの確認待ちです: <%= resource.unconfirmed_email %></div>
            <% end %>

            <div class="mb-3">
              <%= f.label :password, "新しいパスワード", class: "form-label fw-bold" %> <span class="text-muted small">（変更しない場合は空欄のまま）</span>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
              <% if @minimum_password_length %>
                <div class="form-text small"><%= @minimum_password_length %> 文字以上にする必要があります</div>
              <% end %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "新しいパスワード（確認用）", class: "form-label fw-bold" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="mb-4 p-3 bg-light rounded border">
              <%= f.label :current_password, "現在のパスワード", class: "form-label fw-bold text-danger" %> <span class="text-muted small">（変更を確定するには入力が必要です）</span>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <%= link_to "🛡️ マイページに戻る", user_path(current_user), class: "btn btn-secondary" %>
              <%= f.submit "情報を更新する", class: "btn btn-success fw-bold" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white py-3">
          <h4 class="mb-0 fw-bold fs-5">💀 ギルドからの脱退（退会）</h4>
        </div>
        <div class="card-body p-4 text-center">
          <p class="text-muted small mb-3">
            退会すると、これまでに受注したクエストや冒険者のデータが**すべて完全に削除**されます。この操作は取り消せません。
          </p>
          <%= button_to "ギルドを退会する", registration_path(resource_name), data: { confirm: "本当に退会しますか？すべてのデータが消失します。" }, method: :delete, onclick: "return confirm('本当にモククエストを退会しますか？この操作は取り消せません。');", class: "btn btn-outline-danger fw-bold w-100" %>
        </div>
      </div>

    </div>
  </div>
</div>