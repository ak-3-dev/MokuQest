  [31m[1m"[0m[31mdescription[0m[31m[1m"[0m=>
   [31m[1m"[0m[31mActive Storageを使って画像やファイルをアップロードし、表示する方法を学ぶ。ローカル/クラウド（S3など）に保存する設定も確認する。[0m[31m[1m"[0m,
  [31m[1m"[0m[31mexp[0m[31m[1m"[0m=>[34m[1m80[0m},
 {[31m[1m"[0m[31mtitle[0m[31m[1m"[0m=>[31m[1m"[0m[31mDay 18: テスト基礎（MinitestまたはRSpec）[0m[31m[1m"[0m,
  [31m[1m"[0m[31mdescription[0m[31m[1m"[0m=>[31m[1m"[0m[31mモデル、コントローラ、フィーチャ（統合）テストの基本を書いて実行する。テスト駆動開発（TDD）の簡単な流れを体験する。[0m[31m[1m"[0m,
  [31m[1m"[0m[31mexp[0m[31m[1m"[0m=>[34m[1m100[0m},
