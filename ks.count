  [31m[1m"[0m[31mdescription[0m[31m[1m"[0m=>
   [31m[1m"[0m[31mAction Cableの基礎を学び、簡単なチャット機能やリアルタイム更新を実装してWebSocketの動作を理解する。[0m[31m[1m"[0m,
  [31m[1m"[0m[31mexp[0m[31m[1m"[0m=>[34m[1m120[0m},
