  [31m[1m"[0m[31mdescription[0m[31m[1m"[0m=>
   [31m[1m"[0m[31mアセットパイプライン、WebpackerまたはImportmapの役割を理解し、JavaScript/CSSの構成、ビルド、最適化の基本を学ぶ。[0m[31m[1m"[0m,
  [31m[1m"[0m[31mexp[0m[31m[1m"[0m=>[34m[1m60[0m},
