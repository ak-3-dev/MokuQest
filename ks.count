  [31m[1m"[0m[31mdescription[0m[31m[1m"[0m=>
   [31m[1m"[0m[31mHotwire（Turbo + Stimulus）の基本を学び、ページ遷移の高速化やAjax相当のインタラクションを実装する。従来のjQuery連携と比較して理解する。[0m[31m[1m"[0m,
  [31m[1m"[0m[31mexp[0m[31m[1m"[0m=>[34m[1m90[0m},
