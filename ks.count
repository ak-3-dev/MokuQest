  [31m[1m"[0m[31mdescription[0m[31m[1m"[0m=>
   [31m[1m"[0m[31mスコープ、複雑なwhere句、pluck、select、group、SQLの最適化ポイント、N+1問題の回避（includes）を学び実践する。[0m[31m[1m"[0m,
  [31m[1m"[0m[31mexp[0m[31m[1m"[0m=>[34m[1m90[0m},
